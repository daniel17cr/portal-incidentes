@model LoginVm
@{ ViewData["Title"] = "Ingresar"; }
<section class="login card">
  <h1>Ingresar</h1>
  <form method="post" asp-controller="Account" asp-action="LoginPost" asp-route-next="@Context.Request.Query["next"].ToString()" autocomplete="on">
    <label for="username">Usuario</label>
    <input id="username" name="username" type="text" required maxlength="64" autocomplete="username" autofocus>
    <label for="password">Contraseña</label>
    <input id="password" name="password" type="password" required maxlength="128" autocomplete="current-password">
    <button class="btn btn-primary btn-block" type="submit">Ingresar</button>
  </form>
